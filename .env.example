# ============================================================
# Universal RAG - Environment Template
# Copy file ini menjadi `.env` lalu sesuaikan nilainya.
# ============================================================

# === LOGGING ===
# Pilihan: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL="INFO"

# === EMBEDDING CONFIG ===
# Dipakai saat ingest (membuat vector dokumen) dan retrieval dense query.
# Provider auto-detect:
# - OpenAI: base URL berisi api.openai.com
# - Gemini: API key diawali AIza atau AQ.
# - Ollama: base URL berisi "ollama" / "localhost" / "127.0.0.1" / port ":11434" (no API key)
# - OpenAI-compatible (vLLM, dll): selain di atas dengan API key
EMBEDDER_BASE_URL="http://localhost:11434"
EMBEDDER_API_KEY=""
EMBEDDER_MODEL="bge-m3:latest"
# HARUS sama dengan dimensi model embedding yang dipakai.
# Contoh:
# - text-embedding-3-small -> 1536
# - nomic-embed-text:latest -> 768
# - bge-m3:latest -> 1024
EMBEDDER_DIMENSION=1024

# === QDRANT CONFIG ===
# Local dev: http://localhost:6333
# Docker internal network (dari container bot): http://qdrant:6333
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
# Nama collection — kalau ganti dimension embedding, gunakan nama baru
# (tidak bisa reuse collection lama dengan dimension berbeda).
QDRANT_COLLECTION_NAME="dokumen_v2"

# === LLM CHAT CONFIG ===
# Dipakai saat generate jawaban dari konteks retrieval.
# Provider terdeteksi otomatis dari LLM_BASE_URL / LLM_API_KEY (lihat get_llm):
#
#   Ollama (lokal, gratis, paling cepat kalau model muat di GPU):
#     LLM_BASE_URL berisi ":11434" / "ollama" / "localhost", LLM_API_KEY KOSONG.
#     Pilih model yang MUAT di VRAM GPU-mu — model kecil (mis. gemma/qwen ~e2b)
#     jalan puluhan-token/detik di GPU; model besar (12B+) bisa tumpah ke CPU
#     dan justru jauh lebih lambat. Uji latensi dulu sebelum produksi.
#
#   OpenAI-compatible (OpenAI, Z.ai, vLLM, dll): set ketiganya.
#     LLM_BASE_URL="https://api.openai.com/v1"  (atau endpoint provider)
#     LLM_API_KEY="sk-..."  LLM_MODEL="gpt-4o-mini"
#
LLM_BASE_URL="http://localhost:11434"
LLM_API_KEY=""
LLM_MODEL="gemma3:latest"

# === MEMORY CONFIG ===
MEMORY_TYPE="buffer_window"
MEMORY_SESSION_ID="default_session"
# Jumlah pasangan chat (user+assistant) yang disimpan di memory window.
MEMORY_WINDOW_SIZE=5

# === RETRIEVAL TUNING ===
# Nilai minimum relevansi dokumen (0.0-1.0, lebih tinggi = lebih ketat).
SEARCH_SCORE_THRESHOLD=0.7
# Jumlah context documents maksimum yang dikirim ke prompt.
MAX_SEARCH_RESULTS=4

# === INGESTION TUNING ===
# Jumlah point per batch saat upsert ke Qdrant.
EMBEDDING_BATCH_SIZE=100
# Retry maksimum untuk batch scanner.
MAX_BATCH_SCANNER_RETRIES=3

# === SEARCH MODE (FASE 3) ===
# "dense"  = semantic similarity only
# "hybrid" = dense + sparse BM25 (perlu sparse vectors di collection)
SEARCH_MODE="dense"

# === RERANKER (FASE 3) ===
# Jika true, hasil retrieval akan diurutkan ulang oleh cross-encoder.
RERANKER_ENABLED=false
RERANKER_MODEL="Xenova/ms-marco-MiniLM-L-6-v2"
# Skor minimum cross-encoder (typical ~ -10..+10). Di bawah ini = tidak relevan, LLM tidak dipanggil.
RERANKER_MIN_SCORE=0.0

# === WEB SEARCH FALLBACK (9router /v1/search) ===
# Aktifkan fallback web search global (kill-switch admin). Tetap perlu enable_web_search=true per request.
WEB_SEARCH_ENABLED="false"
# Endpoint POST penuh. Kosongkan untuk pakai LLM_BASE_URL + "/search".
WEB_SEARCH_URL=""
# Bearer token. Kosongkan untuk pakai LLM_API_KEY.
WEB_SEARCH_API_KEY=""
# exa = neural search, paling jitu cari sumber terkini (butuh FETCH_CONTENT=true,
# snippet exa kosong). tavily isi snippet sendiri tapi sering usang. search-combo hindari.
# Cek provider tersedia: curl $LLM_BASE_URL/models/web
WEB_SEARCH_PROVIDER="exa"
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10
# Ambil isi halaman penuh top-N (via /v1/web/fetch) -> konteks bertanggal, LLM tak
# mengutip snippet usang. WAJIB "true" untuk exa. Set "false" hanya jika pakai tavily.
WEB_SEARCH_FETCH_CONTENT="true"

# === OCR GATEWAY (opsional, github.com/hafiznugrahadev/ocr-gateway / PaddleOCR) ===
# Kosongkan untuk menonaktifkan OCR. Saat aktif, gambar di dalam .pptx (dan PDF
# scan ke depan) di-OCR dan teksnya ikut diindeks.
OCR_GATEWAY_URL=""
OCR_API_KEY=""
OCR_LANGUAGE="id"
OCR_TIMEOUT=60
# Lewati gambar lebih kecil dari ini (ikon/logo/dekorasi), dalam byte.
OCR_MIN_IMAGE_BYTES=3072

# === WEB SCRAPER ===
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36"

# === TELEGRAM BOT ===
# Dapatkan token dari @BotFather. Jangan commit token asli ke git.
TELEGRAM_BOT_TOKEN=""
# Opsional: whitelist user id Telegram, pisahkan dengan koma.
# Kosongkan untuk menonaktifkan whitelist.
TELEGRAM_ALLOWED_USERS=""

# === API SERVER ===
# Token wajib untuk akses endpoint /api/v1/*
API_BEARER_TOKEN="change-me"
API_HOST="0.0.0.0"
API_PORT=8000
# Pisahkan origin dengan koma. Gunakan "*" hanya untuk dev internal.
API_CORS_ORIGINS="*"

# Folder ingest upload (dipakai CLI ingest-uploads dan API upload endpoint)
UPLOADS_DIR="uploads"
# Batasi endpoint ingest file-path agar hanya bisa membaca di dalam base dir ini.
# Default fallback: sama dengan UPLOADS_DIR.
INGEST_BASE_DIR="uploads"
# Batas upload file API (bytes). Default 104857600 = 100MB.
UPLOAD_MAX_BYTES=104857600
# Batas maksimal konten web yang diambil saat ingest URL (bytes). Contoh 2097152 = 2MB.
WEB_MAX_CONTENT_BYTES=2097152

# === S3 STORAGE (Opsional) ===
# Jika S3_BUCKET diisi, file upload akan dipindah ke S3 setelah ingest
# dan dihapus dari local storage untuk menghemat disk.
# Saat reingest, file akan di-download dari S3 ke temp lalu diproses.
S3_BUCKET="local-rag-files"
# Prefix/folder di dalam bucket (default: rag-uploads)
S3_PREFIX="rag-uploads"
# Endpoint URL khusus untuk S3-compatible storage (MinIO, R2, dll). Kosongkan untuk AWS S3.
S3_ENDPOINT_URL="rustfs.tabalongkab.go.id"
# Region AWS (opsional jika pakai endpoint URL custom)
S3_REGION="us-east-1"
# Credentials: set AWS_ACCESS_KEY_ID dan AWS_SECRET_ACCESS_KEY di env atau gunakan IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=